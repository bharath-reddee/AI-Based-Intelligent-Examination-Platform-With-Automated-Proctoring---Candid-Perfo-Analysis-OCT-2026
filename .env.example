# ============================================================
# AI Examination Platform Environment Configuration Template
# Copy this file to api_keys.env or .env and replace placeholders
# with your actual API credentials.
# ============================================================

# OpenAI API Key (Required for GPT-4o-mini, GPT-4o, etc.)
OPENAI_API_KEY=your_openai_api_key_here

# Google Gemini API Key (Required for Gemini-1.5-flash / Gemini-2.0-flash testing)
GOOGLE_API_KEY=your_google_gemini_api_key_here

# Default AI Models
OPENAI_MODEL=gpt-4o-mini
GEMINI_MODEL=gemini-1.5-flash
OCR_MODEL=gpt-4o
